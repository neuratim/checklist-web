{
    "name": "neuratim.checklist",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/localize.mjs && node scripts/verify-seo.mjs && node scripts/verify-privacy.mjs && node scripts/verify-startup.mjs && node scripts/verify-hosting.mjs",
        "dev": "vite",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "oxlint",
        "preview": "vite preview",
        "test": "node --test scripts/*.test.mjs",
        "tsc": "tsc --noEmit",
        "verify:privacy": "node scripts/verify-privacy.mjs",
        "verify:seo": "node scripts/verify-seo.mjs"
    },
    "dependencies": {
        "@stripe/react-stripe-js": "7.0.1",
        "@stripe/stripe-js": "10.2.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "stripe": "23.0.1"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "oxlint": "1.90.0",
        "prettier": "3.9.10",
        "typescript": "7.0.2",
        "vite": "8.3.5"
    }
}
