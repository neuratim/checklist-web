# Public site configuration — safe to commit, no secrets.
# Baked into the build at compile time by Vite (import.meta.env.*  /  %VITE_*% in index.html).
# Override per-environment in the Cloudflare Pages dashboard if a preview/staging value is ever needed.
VITE_CONTACT_EMAIL=info@neuratim.com
VITE_SITE_URL=https://checklist.neuratim.com
VITE_APP_URL=https://checklist-app.neuratim.com

# Optional tip links, shown on the Free & Support section only when set. Same shared
# NeuraTiM accounts as the hub site (../../web/.env) — see ../../web/PAYMENTS.md.
VITE_KOFI_URL=https://ko-fi.com/neuratim
VITE_PAYPAL_URL=https://paypal.me/neuratim
VITE_GITHUB_SPONSORS_URL=https://github.com/sponsors/neuratim

# Stripe publishable key (safe to expose client-side) - enables the in-page quick tip
# card/Apple Pay/Google Pay widget. Same key as the hub site; the secret key and the
# Worker that creates PaymentIntents live only in ../../web (see ../../web/PAYMENTS.md
# and ../../web/AI_TEMPLATE_GUIDE.md §5) — this site calls that Worker cross-origin.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51TwLmiE7FseUqcRbaOXJoIEj6FS8xBoxNRxqxznllw94bZRquyO3WkeKbQ5ayTm3JnQou8tH7AtlUWV0Y341n8b100fEJSswyO
VITE_STRIPE_API_BASE_URL=https://neuratim.com
